{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "firefly-iii-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-27",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": {
    "enabled": true,
  },
  "migrations": [
		{
			"new_sqlite_classes": ["FireflyIIIAgent"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "FireflyIIIAgent",
				"name": "MCP_OBJECT"
			}
		]
	},
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "2f35204836154a9b84e99e347d4cc6e0"
    }
  ],
  // Login is delegated to Firefly III's own OAuth server (Laravel Passport) —
  // each user signs in with their real Firefly III username/password on
  // Firefly's own /login page; this worker never sees or stores a password.
  // FIREFLY_OAUTH_CLIENT_SECRET is a secret: wrangler secret put FIREFLY_OAUTH_CLIENT_SECRET
  // Client registered on fin.bohar.online via:
  //   php8.5 artisan passport:client --name='Firefly III MCP' \
  //     --redirect_uri='https://firefly-iii-mcp.thisanthan02.workers.dev/callback' -n
  //
  // MCP_STATE_SIGNING_KEY is a secret: wrangler secret put MCP_STATE_SIGNING_KEY
  // HMAC key for the OAuth `state` param (see src/state.ts) — 32+ random bytes,
  // e.g. `openssl rand -hex 32`. Not a user credential; rotate freely if ever
  // suspected leaked, which just invalidates in-flight login attempts.
  "vars": {
    "FIREFLY_III_BASE_URL": "https://fin.bohar.online",
    "FIREFLY_OAUTH_CLIENT_ID": "019fcc52-7aaf-737a-ad55-d86fbe025674",
    "FIREFLY_OAUTH_REDIRECT_URI": "https://firefly-iii-mcp.thisanthan02.workers.dev/callback",
    "ENVIRONMENT": "production",
    // Default tool surface is the 'safe' preset only (personal-finance read/write,
    // no deletes, no admin) — see packages/core/src/tool-risk.ts. Set to "advanced"
    // to also allow deletes and full resource management (bills/budgets/piggy
    // banks/recurring/attachments/rules). Administrative tools (destroy_data,
    // user/webhook/currency/configuration admin, bulk destructive ops) are never
    // included by either value — see MCP_ENABLE_ADMIN_TOOLS below.
    "MCP_TOOL_PRESET": "safe",
    // Administrative tools require BOTH this flag AND MCP_ADMIN_TOOL_ALLOWLIST
    // naming each one explicitly — setting this alone enables nothing.
    "MCP_ENABLE_ADMIN_TOOLS": "false"
    // "MCP_ADMIN_TOOL_ALLOWLIST": "store_user,delete_user"
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
